#!/usr/bin/env sh

exec 1>&2

# pixi.lock is deliberately held at v6: helios runs pixi 0.67.1, which cannot read v7.
# Any `pixi run` without --frozen silently rewrites it, and the diff is ~12k lines, so
# it is easy to wave through in review and only shows up as a failed submission later.
if [ -f pixi.lock ] && [ "$(head -n 1 pixi.lock)" != "version: 6" ]; then
    echo "pixi.lock is not version 6 -- helios cannot read a v7 lock."
    echo "Run: git checkout -- pixi.lock"
    echo "Then bypass pixi for running things here: ./.pixi/envs/default/bin/python ..."
    exit 1
fi

# Call black through the environment's own interpreter rather than `pixi run`.
# pixi.toml declares requires-pixi to stop a too-new pixi rewriting the lock to v7, and
# that bound refuses `pixi run` on exactly the modern pixi most people have -- so routing
# this through pixi would fail every commit. Bypassing it is the same workaround
# documents/issues.md gives for running anything else in this repo.
BLACK_PY="./.pixi/envs/default/bin/python"
if [ ! -x "$BLACK_PY" ]; then
    echo "No pixi environment at $BLACK_PY; skipping the formatting check."
    echo "Run 'pixi install --frozen' to get one."
    exit 0
fi
if ! "$BLACK_PY" -m black --check .
then
    echo "Black formatting check failed"
    exit 1
fi
